# openapi-typescript@7 declares peer typescript@^5.x and this project runs TS 6.
# The pairing works (the lockfile has resolved them together since day one), but a
# fresh `npm install` on CI re-resolves and rejects it. This makes CI behave like
# local. Remove once openapi-typescript widens its peer range to include TS 6.
legacy-peer-deps=true
